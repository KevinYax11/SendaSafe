# Use a unique password of at least 16 characters to enable /admin.
SENDASAFE_ADMIN_PASSWORD=
# Independent random secret (at least 32 characters) for administrative sessions.
SENDASAFE_SESSION_SECRET=
# Optional. Defaults to storage/sendasafe.sqlite.
SENDASAFE_DB_PATH=
# Optional remote SQLite database for Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
